<odoo>
    <data>
        <record id="view_leave_policy_form" model="ir.ui.view">
            <field name="name">hr.leave.policy.form</field>
            <field name="model">hr.leave.policy</field>
            <field name="arch" type="xml">
                <form string="Politique de Congés">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="annual_quota"/>
                            <field name="max_carry_forward"/>
                            <field name="approval_level"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_leave_policy_tree" model="ir.ui.view">
            <field name="name">hr.leave.policy.tree</field>
            <field name="model">hr.leave.policy</field>
            <field name="arch" type="xml">
                <list string="Politiques de Congés">
                    <field name="name"/>
                    <field name="annual_quota"/>
                    <field name="max_carry_forward"/>
                    <field name="approval_level"/>
                </list>
            </field>
        </record>

        <record id="action_leave_policy" model="ir.actions.act_window">
            <field name="name">Politiques de Congés</field>
            <field name="res_model">hr.leave.policy</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>