<odoo>
    <data>
        <record id="module_category_it_conges" model="ir.module.category">
            <field name="name">IT Congés</field>
        </record>

        <record id="group_conge_employe" model="res.groups">
            <field name="name">Employé</field>
            <field name="category_id" ref="module_category_it_conges"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_conge_manager" model="res.groups">
            <field name="name">Manager Congés</field>
            <field name="category_id" ref="module_category_it_conges"/>
            <field name="implied_ids" eval="[(4, ref('group_conge_employe'))]"/>
        </record>

        <record id="group_conge_rh" model="res.groups">
            <field name="name">RH</field>
            <field name="category_id" ref="module_category_it_conges"/>
            <field name="implied_ids" eval="[(4, ref('group_conge_manager'))]"/>
        </record>
    </data>
</odoo>