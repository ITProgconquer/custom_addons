<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_annuler_appel_wizard_form" model="ir.ui.view">
            <field name="name">annuler.appel.wizard.form</field>
            <field name="model">gespro.appel.annuler.wizard</field>
            <field name="arch" type="xml">
                <form string="Annuler l'Appel à Concurrence">
                    <group>
                        <field name="motif" placeholder="Raison de l'annulation..." required="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm_annuler" string="Confirmer l'annulation" type="object" class="btn-danger"/>
                        <button string="Annuler" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>