<odoo>
    <data>
        <record id="module_category_it_contrats" model="ir.module.category">
            <field name="name">IT Contrats</field>
        </record>

        <record id="group_contrat_user" model="res.groups">
            <field name="name">Utilisateur Contrats</field>
            <field name="category_id" ref="module_category_it_contrats"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_contrat_rh" model="res.groups">
            <field name="name">RH Contrats</field>
            <field name="category_id" ref="module_category_it_contrats"/>
            <field name="implied_ids" eval="[(4, ref('group_contrat_user'))]"/>
        </record>
    </data>
</odoo>